{
  "version": 8,
  "name": "Hyrule",
  "metadata": {
    "minimapa": {
      "label": "Hyrule",
      "skin": "zelda",
      "hud": ["regiao"],
      "route": { "color": "#3b9aac", "casing": "#0b2230", "glow": "#27849e" },
      "ui": {
        "bg": "rgba(10, 30, 44, 0.9)",
        "fg": "#e6f4f6",
        "accent": "#40d0f2",
        "accent-fg": "#04202b",
        "player-fill": "#f5f938",
        "player-stroke": "#f5f938",
        "font": "'Cinzel', Georgia, serif"
      },
      "cores": "Medidas de referencias/hyrule-totk-mapa.png (ver referencias/paletas.md). Quadras = prédios em mostarda (o OSM quase não marca áreas residenciais em SP). Rota no ciano da borda (#3b9aac). Halo dos rótulos derivado do fundo #252729. Curvas de nível (Mapterhorn) inseridas em src/map/contornos.ts."
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#252729", "background-pattern": "grade-hyrule" }
    },

    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#493a09" }
    },
    {
      "id": "landuse-verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["cemetery", "pitch", "stadium", "golf", "playground"], true, false],
      "paint": { "fill-color": "#493a09" }
    },
    {
      "id": "landcover-verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "grass", "farmland", "wetland"], true, false],
      "paint": { "fill-color": "#493a09" }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#545953" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#294e59",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 2.5]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#584d20",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 1]
      }
    },

    {
      "id": "borda-brilho",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "line-color": "#3b9aac", "line-width": 5, "line-blur": 4, "line-opacity": 0.5 }
    },
    {
      "id": "borda-agua-brilho",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#3b9aac", "line-width": 5, "line-blur": 4, "line-opacity": 0.5 }
    },
    {
      "id": "borda",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "line-color": "#206d8f", "line-width": 1.4 }
    },
    {
      "id": "borda-agua",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#206d8f", "line-width": 1.4 }
    },

    {
      "id": "aeroway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["runway", "taxiway"], true, false],
      "paint": {
        "line-color": "#a39d7b",
        "line-opacity": 0.6,
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 2, 17, 30]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#a39d7b",
        "line-opacity": 0.6,
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 17,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": { "line-color": "#a39d7b", "line-opacity": 0.5, "line-width": 1 }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match", ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#a39d7b",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 0.9],
        "line-width": [
          "interpolate", ["exponential", 1.4], ["zoom"],
          8, ["match", ["get", "class"], ["motorway", "trunk"], 1, 0],
          12, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 1.6, ["minor", "service"], 0.5, 1],
          15, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 3.5, ["minor", "service"], 1.4, 2.5],
          18, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 9, ["minor", "service"], 4, 6]
        ]
      }
    },

    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Cinzel"],
        "text-size": 13,
        "text-letter-spacing": 0.1
      },
      "paint": { "text-color": "#3b9aac", "text-halo-color": "rgba(37, 39, 41, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-water-line",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Cinzel"],
        "text-size": 13,
        "text-letter-spacing": 0.1
      },
      "paint": { "text-color": "#3b9aac", "text-halo-color": "rgba(37, 39, 41, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Cinzel"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 17, 13],
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": { "text-color": "#cfbe7b", "text-halo-color": "rgba(37, 39, 41, 0.75)", "text-halo-width": 1.4 }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": ["match", ["get", "class"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Cinzel"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 13, 15, 18],
        "text-max-width": 8
      },
      "paint": { "text-color": "#cfbe7b", "text-halo-color": "rgba(37, 39, 41, 0.75)", "text-halo-width": 1.6 }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 14,
      "filter": ["match", ["get", "class"], ["city", "town", "village"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Cinzel"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 14, 12, 24],
        "text-max-width": 8
      },
      "paint": { "text-color": "#cfbe7b", "text-halo-color": "rgba(37, 39, 41, 0.75)", "text-halo-width": 2 }
    }
  ]
}
