{
  "version": 8,
  "name": "Minecraft (mapa)",
  "metadata": {
    "minimapa": {
      "label": "Minecraft (mapa)",
      "skin": "mc",
      "hud": ["posicao"],
      "containerClass": "moldura-mc",
      "route": { "color": "#ff0000", "casing": "#870000", "glow": "#ff0000", "estilo": "redstone" },
      "cameraFiel": true,
      "iconesEmBlocos": true,
      "ui": {
        "bg": "#c6c6c6",
        "fg": "#373737",
        "accent": "#2f6b1f",
        "accent-fg": "#ffffff",
        "player-fill": "#eeeeee",
        "player-stroke": "#000000",
        "font": "'Pixelify Sans', 'Courier New', ui-monospace, monospace"
      },
      "cores": "Tabela oficial de cores do item mapa (minecraft.wiki/w/Map_item_format; ver referencias/paletas.md): cada cor-base com seus tons (base × 180, 220, 255, 135 / 255). Texturas em src/map/patterns.ts; prédios e sombras gerados em themes.ts (prediosMinecraftMapa). Rota de redstone: FIRE (acesa) e NETHER (apagada). Halo dos rótulos derivado do fundo da caixa Position (#0b1418)."
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#6d9930", "background-pattern": "grama-mc" }
    },

    {
      "id": "landcover-campo",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "farmland"], true, false],
      "paint": { "fill-pattern": "campo-mc", "fill-antialias": false }
    },
    {
      "id": "landcover-arvores",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "wetland"], true, false],
      "paint": { "fill-pattern": "folhas-mc", "fill-antialias": false }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-pattern": "parque-mc", "fill-antialias": false }
    },
    {
      "id": "landuse-verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["cemetery", "pitch", "stadium", "golf", "playground"], true, false],
      "paint": { "fill-pattern": "campo-mc", "fill-antialias": false }
    },
    {
      "id": "landcover-areia",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"],
      "paint": { "fill-pattern": "areia-mc", "fill-antialias": false }
    },
    {
      "id": "landcover-neve",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["ice", "rock"], true, false],
      "paint": {
        "fill-pattern": ["match", ["get", "class"], "rock", "pedra-predio-mc", "neve-mc"],
        "fill-antialias": false
      }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-pattern": "agua-mc", "fill-antialias": false }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#3737dc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 4]
      }
    },

    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#4f4f4f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 18, 3]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 17,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": { "line-color": "#825e42", "line-width": 4 }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match", ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false
      ],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#606060",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.35, 1],
        "line-width": [
          "interpolate", ["exponential", 1.5], ["zoom"],
          8, ["match", ["get", "class"], ["motorway", "trunk"], 1.5, 0],
          12, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 3, ["minor", "service"], 1, 2],
          15, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 9, ["minor", "service"], 4, 7],
          18, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 30, ["minor", "service"], 14, 22]
        ]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#606060", "fill-antialias": false }
    },

    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Pixelify Sans"],
        "text-size": 48
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#0b1418", "text-halo-width": 4, "text-halo-blur": 0 }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Pixelify Sans"],
        "text-size": 48,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#0b1418", "text-halo-width": 4, "text-halo-blur": 0 }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": ["match", ["get", "class"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Pixelify Sans"],
        "text-size": 48,
        "text-max-width": 8
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#0b1418", "text-halo-width": 4, "text-halo-blur": 0 }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 14,
      "filter": ["match", ["get", "class"], ["city", "town", "village"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Pixelify Sans"],
        "text-size": 56,
        "text-max-width": 8
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#0b1418", "text-halo-width": 4, "text-halo-blur": 0 }
    }
  ]
}
