{
  "version": 8,
  "name": "Red Dead",
  "metadata": {
    "minimapa": {
      "label": "Red Dead",
      "skin": "rdr",
      "hud": ["bussola"],
      "route": { "color": "#9e1b1b", "casing": "#2b1a12", "glow": "#c0392b" },
      "ui": {
        "bg": "rgba(241, 230, 204, 0.97)",
        "fg": "#2b1a12",
        "accent": "#9e1b1b",
        "accent-fg": "#fff6e6",
        "player-fill": "#ffffff",
        "player-stroke": "#0c0503",
        "font": "'IM Fell English', Georgia, 'Times New Roman', serif"
      },
      "cores": "Medidas de referencias/rdr2-minimapa.png (ver referencias/paletas.md). Água não aparece na referência: tom de papel mais escuro #b3a68d (o granulado medido) com contorno carvão, derivado. Halo dos rótulos derivado do papel #dcc19c. Rota vermelha e destino não aparecem na referência (mantidos)."
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#dcc19c", "background-pattern": "papel-rdr" }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#b3a68d" }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#444339", "line-width": 1.2 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#444339",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 1.6]
      }
    },

    {
      "id": "park-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 12,
      "paint": {
        "line-color": "#434335",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 17, 2.2],
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "green-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["cemetery", "pitch", "stadium", "golf", "playground"], true, false],
      "paint": {
        "line-color": "#434335",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1, 17, 2.2],
        "line-dasharray": [3, 2]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#cfb793",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15, 1]
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "line-color": "#444339",
        "line-width": ["interpolate", ["linear"], ["zoom"], 15, 0.6, 17, 1.6, 19, 2.4]
      }
    },

    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#41423d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 18, 2],
        "line-dasharray": [4, 2]
      }
    },

    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 17,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": {
        "line-color": "#41423d",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match", ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false
      ],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#41423d",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, ["match", ["get", "class"], ["motorway", "trunk"], 1, 0],
          12, ["match", ["get", "class"], ["minor", "service"], 0.8, 1.4],
          15, ["match", ["get", "class"], ["service"], 1.6, 2.6],
          18, ["match", ["get", "class"], ["service"], 3, 5]
        ]
      }
    },

    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["IM Fell English"],
        "text-size": 14,
        "text-letter-spacing": 0.1
      },
      "paint": { "text-color": "#444339", "text-halo-color": "rgba(220, 193, 156, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-water-line",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["IM Fell English"],
        "text-size": 14,
        "text-letter-spacing": 0.1
      },
      "paint": { "text-color": "#444339", "text-halo-color": "rgba(220, 193, 156, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["IM Fell English"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 11, 17, 14],
        "text-offset": [0, -0.8],
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": { "text-color": "#2b1a12", "text-halo-color": "rgba(220, 193, 156, 0.75)", "text-halo-width": 1.4 }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": ["match", ["get", "class"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Rye"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 12, 15, 17],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 8
      },
      "paint": { "text-color": "#2b1a12", "text-halo-color": "rgba(220, 193, 156, 0.75)", "text-halo-width": 1.5 }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 14,
      "filter": ["match", ["get", "class"], ["city", "town", "village"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Rye"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 14, 12, 24],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-max-width": 8
      },
      "paint": { "text-color": "#2b1a12", "text-halo-color": "rgba(220, 193, 156, 0.75)", "text-halo-width": 2 }
    }
  ]
}
