{
  "version": 8,
  "name": "Mario World",
  "metadata": {
    "minimapa": {
      "label": "Mario World",
      "skin": "smw",
      "containerClass": "pixelado-smw",
      "route": {
        "color": "#f8d000",
        "casing": "#000000",
        "glow": "#f8e8b0",
        "estilo": "smw"
      },
      "ui": {
        "bg": "#000000",
        "fg": "#f0f0f0",
        "accent": "#f8d000",
        "accent-fg": "#000000",
        "player-fill": "#f80000",
        "player-stroke": "#000000",
        "font": "'Press Start 2P', 'Pixelify Sans', 'Courier New', monospace"
      },
      "cores": "Cores exatas do mapa-múndi do Super Mario World (referencias/paletas.md, pixel art de paleta fechada). Texturas em src/map/patterns.ts (SMW); mesas (prédios) em themes.ts (prediosSmw). DERIVADAS: ferrovias na cor da madeira das escadas e pontes (#785030); rótulos brancos (#f0f0f0) com contorno preto, as cores das placas do jogo; rota alternativa com pontos na sombra da pedra (#908060). Rótulos em Pixelify Sans de 36 px (12 pixels do canvas): a Press Start 2P, mais parecida com a do jogo, é larga demais para nomes de rua e fica só na interface."
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#40d020",
        "background-pattern": "grama-smw"
      }
    },
    {
      "id": "landcover-arvores",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "wetland"
        ],
        true,
        false
      ],
      "paint": {
        "fill-pattern": "arvores-smw",
        "fill-antialias": false
      }
    },
    {
      "id": "landcover-parque",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "subclass"
        ],
        [
          "park",
          "garden",
          "village_green",
          "recreation_ground"
        ],
        true,
        false
      ],
      "paint": {
        "fill-pattern": "parque-smw",
        "fill-antialias": false
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-pattern": "parque-smw",
        "fill-antialias": false
      }
    },
    {
      "id": "landcover-pedra",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "sand",
          "rock",
          "ice"
        ],
        true,
        false
      ],
      "paint": {
        "fill-pattern": "pedra-smw",
        "fill-antialias": false
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-pattern": "agua-smw",
        "fill-antialias": false
      }
    },
    {
      "id": "water-contorno",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 12,
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "line-color": "#000000",
        "line-width": 3
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "line-color": "#4088f8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          3,
          16,
          9
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "rail",
          "transit"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#785030",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          3,
          18,
          9
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 17,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "path",
          "track"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#f8e8b0",
        "line-width": 6
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor",
          "service"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#f8e8b0",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          8,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.5,
            0
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            3,
            [
              "minor",
              "service"
            ],
            1,
            2
          ],
          15,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            12,
            [
              "minor",
              "service"
            ],
            6,
            9
          ],
          18,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            36,
            [
              "minor",
              "service"
            ],
            18,
            27
          ]
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#d89860"
      }
    },
    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": [
        "match",
        [
          "geometry-type"
        ],
        [
          "Point",
          "MultiPoint"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:pt"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Pixelify Sans"
        ],
        "text-size": 36,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#f0f0f0",
        "text-halo-color": "#000000",
        "text-halo-width": 3,
        "text-halo-blur": 0
      }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary",
          "minor"
        ],
        true,
        false
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:pt"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Pixelify Sans"
        ],
        "text-size": 36,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#f0f0f0",
        "text-halo-color": "#000000",
        "text-halo-width": 3,
        "text-halo-blur": 0
      }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "suburb",
          "quarter",
          "neighbourhood"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:pt"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Pixelify Sans"
        ],
        "text-size": 36,
