{
  "version": 8,
  "name": "Los Santos",
  "metadata": {
    "minimapa": {
      "label": "Los Santos",
      "skin": "gta",
      "hud": ["local", "escala"],
      "route": { "color": "#c93fe0", "casing": "#3a0d45", "glow": "#e27bf2" },
      "ui": {
        "bg": "rgba(12, 12, 10, 0.86)",
        "fg": "#ffffff",
        "accent": "#c93fe0",
        "player-fill": "#a2dca2",
        "player-stroke": "#0c0c0a",
        "font": "'Oswald', 'Arial Narrow', 'Roboto Condensed', system-ui, sans-serif"
      },
      "cores": "Medidas de referencias/gtav-mapa.png (ver referencias/paletas.md). Rota e destino magenta não aparecem na referência (mantidos). Halo dos rótulos derivado do fundo #181818."
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#181818" }
    },

    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "wetland"], true, false],
      "paint": { "fill-color": "#3c422e", "fill-opacity": 0.75 }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "farmland", "sand"], true, false],
      "paint": { "fill-color": "#4c4e36", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#4c4e36", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["cemetery", "pitch", "stadium", "golf"], true, false],
      "paint": { "fill-color": "#4c4e36", "fill-opacity": 0.7 }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#292b26" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#292b26",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 8, 0.5, 14, 2, 18, 6]
      }
    },

    {
      "id": "aeroway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["runway", "taxiway"], true, false],
      "paint": {
        "line-color": "#5d5d5b",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 2, 17, 40]
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#363636",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15, 1]
      }
    },

    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#5d5d5b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 2],
        "line-dasharray": [3, 2]
      }
    },

    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 17,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#5d5d5b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 17, 1.5, 19, 3]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match", ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#979797",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.35, 1],
        "line-width": [
          "interpolate", ["exponential", 1.6], ["zoom"],
          7, ["match", ["get", "class"], ["motorway", "trunk"], 1, 0],
          12, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 2.2, ["secondary", "tertiary"], 1.6, 0.8],
          15, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 7, ["secondary", "tertiary"], 6, ["service"], 3, 5],
          18, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 24, ["secondary", "tertiary"], 21, ["service"], 11, 18]
        ]
      }
    },

    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Oswald"],
        "text-size": 13,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.2
      },
      "paint": { "text-color": "#979797", "text-halo-color": "rgba(24, 24, 24, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-water-line",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Oswald"],
        "text-size": 13,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.2
      },
      "paint": { "text-color": "#979797", "text-halo-color": "rgba(24, 24, 24, 0.75)", "text-halo-width": 1.2 }
    },
    {
      "id": "label-road",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Oswald"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 17, 13],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "rgba(24, 24, 24, 0.75)", "text-halo-width": 1.4 }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": ["match", ["get", "class"], ["suburb", "quarter", "neighbourhood"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Oswald"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 11, 15, 15],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.25,
        "text-max-width": 8
      },
      "paint": { "text-color": "#c6c6c4", "text-halo-color": "rgba(24, 24, 24, 0.75)", "text-halo-width": 1.5 }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 14,
      "filter": ["match", ["get", "class"], ["city", "town", "village"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:pt"], ["get", "name"]],
        "text-font": ["Oswald"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 20],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.3,
        "text-max-width": 8
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "rgba(24, 24, 24, 0.75)", "text-halo-width": 2 }
    }
  ]
}
